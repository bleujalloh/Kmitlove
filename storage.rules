rules_version = '2';

// Même principe que firestore.rules : tout interdit par défaut.
service firebase.storage {
  match /b/{bucket}/o {

    // Consentement RGPD art. 9 et dépôt de fichiers (14/11/2026) : Storage ne
    // contrôle PAS le consentement. Un contrôle `firestore.get(user_status)`
    // a été essayé et déployé : l'émulateur l'acceptait, mais la production
    // refusait le dépôt À TOUS les membres, consentement valide compris
    // (cause non élucidée) — retiré le jour même. Le consentement reste
    // imposé là où le fichier est réellement exploité : création du document
    // de la photo (firestore.rules, qui déclenche l'analyse Cloud Vision) et
    // fonctions appelables (enveloppe `onCall`). Un fichier déposé sans
    // consentement reste donc inerte : jamais analysé, jamais approuvé,
    // jamais montré.

    // Photos de profil : le propriétaire peut déposer la sienne,
    // la lecture publique n'est ouverte qu'une fois la photo validée
    // (ce statut est géré en base par une Cloud Function, pas ici).
    match /profile_photos/{userId}/{fileName} {
      // Lecture publique seulement si la photo est vraiment "approved"
      // en base (docs/regles-messagerie-securite.md section 1) — sans ce
      // contrôle, connaître/deviner le chemin suffirait à voir une photo
      // encore en attente ou refusée.
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        firestore.get(/databases/(default)/documents/users/$(userId)/photos/$(fileName.split('.')[0])).data.status == 'approved'
      );
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024;
    }

    // Photos échangées en messagerie : lisibles/déposables uniquement
    // par les deux membres du match concerné (docs/regles-messagerie-securite.md
    // section 2). Le flou par défaut à la première réception est géré
    // côté client (pas de notion de statut ici), voir chat_screen.dart.
    //
    // Durcie le 14/11/2026 (revue indépendante) : lecture fichier par fichier
    // seulement (pas de liste du dossier, sinon l'autre membre voyait des
    // photos jamais envoyées) ; création seule, jamais d'écrasement d'une
    // photo déjà envoyée ; membre non bloqué ; image JPEG au nom attendu
    // (identifiant aléatoire) ; l'auteur de l'envoi est inscrit dans les
    // métadonnées (`uploaderUid`), ce qui lui seul permet de supprimer son
    // propre fichier si l'envoi du message échoue, et que `sendMessage`
    // vérifie avant de publier la photo.
    match /chat_photos/{matchId}/{fileName} {
      function isMatchMember() {
        return request.auth != null && request.auth.uid in
          firestore.get(/databases/(default)/documents/matches/$(matchId)).data.members;
      }
      function notBlocked() {
        return !firestore.exists(/databases/(default)/documents/blocks/$(matchId));
      }
      allow get: if isMatchMember();
      allow create: if isMatchMember() && notBlocked()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && fileName.matches('[0-9a-f-]{36}[.]jpg')
        && request.resource.metadata.uploaderUid == request.auth.uid;
      allow delete: if isMatchMember() && resource.metadata.uploaderUid == request.auth.uid;
    }

    // Affiche/visuel d'un événement Communauté (spec section 6, 11/11/2026) :
    // image promotionnelle publique par nature (comme le texte de la
    // publication elle-même), jamais une donnée sensible à masquer —
    // contrairement aux photos de profil, pas de statut d'approbation ici.
    // Déposée par l'organisateur avant la création du post lui-même
    // (createCommunityPost reçoit un chemin déjà en place), donc rangée
    // par uid et non par postId.
    match /event_posters/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024;
    }

    // Pièce de vérification d'identité (selfie/vidéo, docs/regles-complementaires-concurrents.md
    // section 1) : jamais visible par un autre membre, seule la Cloud
    // Function de revue admin y accède (Admin SDK, hors de ces règles).
    match /identity_verifications/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 20 * 1024 * 1024;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
