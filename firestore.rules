rules_version = '2';

// Principe du moindre privilège (docs/regles-du-projet.md section 2) :
// tout est interdit par défaut, on ouvre explicitement ce qui est nécessaire.
// La logique sensible (score, matchs, Premium, modération) reste dans les
// Cloud Functions ; ces règles ne couvrent que la lecture/écriture directe.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Profil public d'un membre : lisible par les membres connectés,
    // modifiable uniquement par son propriétaire. Les champs sensibles
    // (position précise, résultat du questionnaire de filtrage) ne sont
    // jamais stockés dans ce document — voir docs/architecture-technique.md.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId);
      allow delete: if false; // la suppression de compte passe par une Cloud Function (anonymisation RGPD)
    }

    // Statut d'activation du compte (filtrage, suspension, premium...).
    // Lisible par son propriétaire pour afficher l'état à l'écran,
    // jamais modifiable depuis le client — uniquement par les Cloud
    // Functions via l'Admin SDK (docs/regles-du-projet.md section 1 et 2).
    match /user_status/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Tentatives du questionnaire de filtrage : jamais de lecture/écriture
    // directe. Le client ne voit les questions (sans la bonne réponse) et
    // le résultat qu'à travers les Cloud Functions appelables.
    match /filtrage_attempts/{attemptId} {
      allow read, write: if false;
    }

    // Banque de questions : jamais accessible au client (ni les questions,
    // pour éviter le bourrage, ni évidemment les bonnes réponses).
    match /filtrage_question_bank/{questionId} {
      allow read, write: if false;
    }

    // Demandes de révision humaine (filtrage, signalements...) : jamais
    // lues/écrites directement, uniquement via Cloud Functions, l'espace
    // admin y accède avec les droits serveur.
    match /moderation_requests/{requestId} {
      allow read, write: if false;
    }

    // Banque de questions du test de compatibilité : lisible par tous les
    // membres connectés (pas de "bonne réponse" à cacher, contrairement
    // au filtrage), jamais modifiable depuis le client.
    match /compat_question_bank/{questionId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Réponses au test de compatibilité : visibles et modifiables
    // uniquement par leur auteur, jamais par un autre membre — même le
    // calcul de compatibilité ne les expose jamais, seul le score final
    // est communiqué (docs/regles-economie-et-compatibilite.md section 2).
    match /compat_answers/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Swipes (likes/passes) : jamais lus/écrits directement — la limite
    // quotidienne de likes et la détection de match doivent être
    // appliquées côté serveur, pas déclarées par le client
    // (docs/regles-complementaires-concurrents.md section 3).
    match /swipes/{swipeId} {
      allow read, write: if false;
    }

    // Matchs : lisibles par les deux membres concernés une fois créés
    // par la Cloud Function, jamais créés/modifiés depuis le client.
    // `members` permet une requête "mes matchs" (array-contains), ce
    // qu'un simple uid1/uid2 ne permettrait pas côté client.
    match /matches/{matchId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.members;
      allow write: if false;
    }

    // Tout le reste (messages, annonces, événements, jetons,
    // signalements, admin) est ajouté au fur et à mesure de leur
    // implémentation, jamais ouvert "par défaut".
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
