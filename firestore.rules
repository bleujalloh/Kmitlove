rules_version = '2';

// Principe du moindre privilège (docs/regles-du-projet.md section 2) :
// tout est interdit par défaut, on ouvre explicitement ce qui est nécessaire.
// La logique sensible (score, matchs, Premium, modération) reste dans les
// Cloud Functions ; ces règles ne couvrent que la lecture/écriture directe.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Consentement RGPD art. 9 valide — même règle que
    // functions/src/shared/consent.ts (version 1 à changer en même temps ;
    // storage.rules ne contrôle pas le consentement, voir son en-tête).
    function hasConsent(userId) {
      let c = get(/databases/$(database)/documents/user_status/$(userId)).data.sensitiveConsent;
      return c.granted == true && c.version == 1;
    }

    // Profil public d'un membre : lisible par les membres connectés,
    // modifiable uniquement par son propriétaire. Les champs sensibles
    // (position précise, résultat du questionnaire de filtrage) ne sont
    // jamais stockés dans ce document — voir docs/architecture-technique.md.
    match /users/{userId} {
      allow read: if isSignedIn();
      // La création/modification passe uniquement par la Cloud Function
      // saveProfil (functions/src/profil/saveProfil.ts) : genre, intention
      // relationnelle, habitudes de vie, qualités et âge minimum sont des
      // listes fermées/règles métier qui doivent être vérifiées côté
      // serveur, jamais seulement par les écrans Flutter (même principe
      // que la confirmation d'âge Google/Apple).
      allow create: if false;
      // Deux préférences de confidentialité (cahier des charges section
      // 4.3) restent de simples booléens sans règle métier à vérifier —
      // seules exceptions à l'écriture exclusivement serveur ci-dessus,
      // sur le même principe que la mise à jour de `readBy` plus bas
      // (affectedKeys().hasOnly(...)) : tout le reste du document doit
      // passer par saveProfil.
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['showReadReceipts', 'compatAnswersVisible'])
        && request.resource.data.get('showReadReceipts', true) is bool
        && request.resource.data.get('compatAnswersVisible', true) is bool;
      allow delete: if false; // la suppression de compte passe par une Cloud Function (anonymisation RGPD)

      // Photos de profil : visibles par tous une fois approuvées, par le
      // propriétaire tant qu'elles sont en attente (docs/regles-messagerie-securite.md
      // section 1). Le statut initial doit être "pending" à la création —
      // seule la Cloud Function planifiée (ou l'admin) peut l'approuver,
      // jamais le propriétaire directement.
      match /photos/{photoId} {
        allow read: if isSignedIn() && (userId == request.auth.uid || resource.data.status == 'approved');
        // Le chemin du fichier est imposé : le serveur le lit, le signe et le
        // supprime avec les droits de l'Admin SDK (export, purge, modération),
        // il ne doit donc jamais pouvoir désigner le fichier d'un autre membre.
        allow create: if isOwner(userId) && request.resource.data.status == 'pending'
          && request.resource.data.uploadedAt == request.time
          && request.resource.data.storagePath == 'profile_photos/' + userId + '/' + photoId + '.jpg'
          && hasConsent(userId);
        allow update: if false;
        allow delete: if isOwner(userId);
      }

      // Événements Communauté enregistrés en favori (spec Communauté
      // section 9, 11/11/2026) : pure préférence personnelle, aucune
      // règle métier à vérifier — propriétaire uniquement, comme les
      // autres sous-collections "privées à soi" de ce projet.
      match /favorites/{postId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Statut d'activation du compte (filtrage, suspension, premium...).
    // Lisible par son propriétaire pour afficher l'état à l'écran,
    // jamais modifiable depuis le client — uniquement par les Cloud
    // Functions via l'Admin SDK (docs/regles-du-projet.md section 1 et 2).
    match /user_status/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Tentatives du questionnaire de filtrage : jamais de lecture/écriture
    // directe. Le client ne voit les questions (sans la bonne réponse) et
    // le résultat qu'à travers les Cloud Functions appelables.
    match /filtrage_attempts/{attemptId} {
      allow read, write: if false;
    }

    // Banque de questions : jamais accessible au client (ni les questions,
    // pour éviter le bourrage, ni évidemment les bonnes réponses).
    match /filtrage_question_bank/{questionId} {
      allow read, write: if false;
    }

    // Demandes de révision humaine (filtrage, signalements...) : jamais
    // lues/écrites directement, uniquement via Cloud Functions, l'espace
    // admin y accède avec les droits serveur.
    match /moderation_requests/{requestId} {
      allow read, write: if false;
    }

    // Banque de questions du test de compatibilité : passe désormais par
    // getCompatQuestions (tirage aléatoire côté serveur, docs/suivi-
    // developpement.md section du 11/11/2026) plutôt qu'une lecture
    // directe de toute la banque — jamais modifiable depuis le client.
    match /compat_question_bank/{questionId} {
      allow read, write: if false;
    }

    // Réponses au test de compatibilité : visibles et modifiables
    // uniquement par leur auteur, jamais par un autre membre — même le
    // calcul de compatibilité ne les expose jamais, seul le score final
    // est communiqué (docs/regles-economie-et-compatibilite.md section 2).
    match /compat_answers/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Swipes (likes/passes) : jamais lus/écrits directement — la limite
    // quotidienne de likes et la détection de match doivent être
    // appliquées côté serveur, pas déclarées par le client
    // (docs/regles-complementaires-concurrents.md section 3).
    match /swipes/{swipeId} {
      allow read, write: if false;
    }

    // Matchs : lisibles par les deux membres concernés une fois créés
    // par la Cloud Function, jamais créés/modifiés depuis le client.
    // `members` permet une requête "mes matchs" (array-contains), ce
    // qu'un simple uid1/uid2 ne permettrait pas côté client.
    match /matches/{matchId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.members;
      // lastMessageAt/lastMessagePreview sont mis à jour par la Cloud
      // Function déclenchée à la création d'un message, jamais par le
      // client directement.
      allow write: if false;

      // Messagerie réservée aux membres du match (docs/regles-messagerie-securite.md
      // section 2), et coupée immédiatement des deux côtés en cas de
      // blocage (match() + blocks ci-dessous).
      match /messages/{messageId} {
        function isMatchMember() {
          return request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.members;
        }
        function isBlocked() {
          return exists(/databases/$(database)/documents/blocks/$(matchId));
        }
        allow read: if isSignedIn() && isMatchMember() && !isBlocked();
        // L'envoi passe uniquement par la fonction `sendMessage` (compte actif,
        // appartenance au match, blocage, longueur, limite de fréquence —
        // functions/src/messagerie/sendMessage.ts) : plus aucune écriture
        // directe, sinon un script pouvait inonder une conversation en
        // contournant la limite (14/11/2026).
        allow create: if false;
        // Seul le marquage "lu" peut être modifié après coup, jamais le
        // contenu du message — et uniquement pour s'ajouter soi-même à
        // readBy, jamais retirer quelqu'un ni ajouter un autre uid que
        // le sien (sinon on pourrait falsifier l'accusé de lecture de
        // n'importe qui).
        allow update: if isSignedIn() && isMatchMember() && !isBlocked()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
          && request.resource.data.readBy.hasAll(resource.data.readBy)
          && request.resource.data.readBy.hasOnly(resource.data.readBy.concat([request.auth.uid]));
        allow delete: if false;
      }
    }

    // Blocage d'une paire de membres : l'identifiant est toujours
    // [uid1, uid2] triés et joints par "_" (même convention que l'identifiant
    // de match, calculé une fois dans messages_repository.dart) — un
    // blocage peut désormais être posé AVANT tout match (depuis Découvrir
    // ou Likes, docs/suivi-developpement.md section du 11/11/2026), pas
    // seulement depuis une conversation déjà matchée. Dès qu'un des deux
    // bloque, getDiscoverCandidates/getLikes excluent la paire des deux
    // côtés, recordSwipe refuse tout nouveau like entre eux, et
    // isBlocked() (plus bas) coupe une conversation déjà existante.
    match /blocks/{pairId} {
      allow read: if isSignedIn() && request.auth.uid in pairId.split('_');
      allow create: if isSignedIn() && request.auth.uid in pairId.split('_')
        && request.resource.data.blockerUid == request.auth.uid
        && request.resource.data.blockedUid is string
        && request.resource.data.blockedUid != request.auth.uid
        && pairId.split('_').hasAll([request.auth.uid, request.resource.data.blockedUid])
        && pairId.split('_').size() == 2;
      allow delete: if isSignedIn() && resource.data.blockerUid == request.auth.uid;
      allow update: if false;
    }

    // Communauté : publications, annonces, événements (cahier des
    // charges section 4.7). Toute création passe par createCommunityPost
    // (modération mixte, limite d'annonces actives, réservation des
    // événements aux membres vérifiés — docs/regles-annonces-evenements.md),
    // jamais une écriture directe. La lecture est ouverte une fois publié,
    // ou réservée à l'auteur tant que ce n'est pas encore validé.
    match /community_posts/{postId} {
      allow read: if isSignedIn() &&
        (resource.data.status == 'published' || resource.data.authorUid == request.auth.uid);
      allow write: if false;

      // Demandes de participation (événements, annonces privées) :
      // visibles par leur auteur et par l'organisateur de la publication,
      // jamais modifiables directement — l'acceptation/le refus et le
      // suivi de présence passent par des Cloud Functions
      // (docs/regles-annonces-evenements.md section 2).
      match /participations/{requesterUid} {
        allow read: if isSignedIn() &&
          (requesterUid == request.auth.uid ||
            get(/databases/$(database)/documents/community_posts/$(postId)).data.authorUid == request.auth.uid);
        allow write: if false;
      }

      // Lieu précis d'un événement/d'une annonce privée, liste des
      // invités d'un événement "sur invitation" : jamais lus
      // directement, uniquement via getEventLocation/requestParticipation/
      // inviteToEvent (vérifient les droits côté serveur).
      match /private/{document=**} {
        allow read, write: if false;
      }

      // Avis après événement (spec Communauté section 9) : visibles par
      // tout membre connecté (aide à choisir un événement), jamais
      // écrits directement — submitEventReview vérifie déjà une
      // participation acceptée avant d'écrire.
      match /reviews/{reviewerUid} {
        allow read: if isSignedIn();
        allow write: if false;
      }

      // J'aime et réponses des publications du fil (prototype Communauté,
      // cahier des charges 4.7) : lisibles par tout membre connecté tant
      // que la publication est publiée (ou pour son auteur), jamais
      // écrits directement — togglePostLike/replyToPost vérifient
      // suspension, blocage, longueur et fréquence côté serveur.
      match /likes/{likerUid} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/community_posts/$(postId)).data.status == 'published' ||
          get(/databases/$(database)/documents/community_posts/$(postId)).data.authorUid == request.auth.uid);
        allow write: if false;
      }
      match /replies/{replyId} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/community_posts/$(postId)).data.status == 'published' ||
          get(/databases/$(database)/documents/community_posts/$(postId)).data.authorUid == request.auth.uid);
        allow write: if false;
      }
    }

    // Table de correspondance code → postId pour le partage privé d'une
    // invitation (spec Communauté section 2, complétée le 11/11/2026) :
    // jamais lue directement — seule redeemEventInviteCode y accède,
    // avec les droits serveur, pour ajouter l'uid de l'appelant à la
    // liste d'invités de l'événement visé.
    match /event_invite_codes/{code} {
      allow read, write: if false;
    }

    // Conseils (onglet "Conseils" de la Communauté, contenu éditorial
    // rédigé par un administrateur — aucune règle métier à vérifier côté
    // utilisateur, donc lecture ouverte à tout membre connecté ; l'écriture
    // passe toujours par adminCreateTip/adminDeleteTip.
    match /community_tips/{tipId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Tout le reste (jetons, admin...) est ajouté au fur et à mesure de
    // leur implémentation, jamais ouvert "par défaut".
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
